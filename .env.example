# Innovate To Escape — Environment Variables
# Copy this file to .env and fill in your values.

# -----------------------------------------------------------------------
# Neon PostgreSQL
# Use the "pooled" connection string for DATABASE_URL (via Neon's pgBouncer)
# Use the "direct" (non-pooled) connection string for DIRECT_URL (Prisma migrations)
# -----------------------------------------------------------------------
DATABASE_URL=
DIRECT_URL=

# -----------------------------------------------------------------------
# Express Session
# Use a long, random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -----------------------------------------------------------------------
SESSION_SECRET=

# -----------------------------------------------------------------------
# Vercel Blob (for Event screenshot uploads)
# Get this token from your Vercel project → Storage → Blob
# -----------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=

# -----------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------
PORT=3001
NODE_ENV=development
